NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Support / admin contact (Guide). Optional; blank hides the action.
NEXT_PUBLIC_SUPPORT_WHATSAPP=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Server-only Firebase Admin credentials.
# Required for admin actions that must run on the server, such as generating
# password reset links from /api/admin/reset-link.
# Never expose these as NEXT_PUBLIC_* values and never commit real secrets.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Optional alternative to FIREBASE_ADMIN_PRIVATE_KEY. Put a base64-encoded
# private key here if your deployment dashboard breaks multiline private keys.
FIREBASE_ADMIN_PRIVATE_KEY_BASE64=
