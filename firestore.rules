rules_version = '2';

// Shopkeeper POS Firestore rules.
//
// Threat model:
//   - A signed-in cashier must not read or write any other shop's data.
//   - A self-registered trial user must land in role='cashier', active,
//     subscriptionStatus='trial' — they cannot promote themselves to admin.
//   - Only an existing active admin may approve users or change their role.
//   - Inactive, pending, expired, or suspended users cannot write POS data.
//   - POS data lives under /users/{uid}/{collection} and is per-user only.
//
// Deploy: `firebase deploy --only firestore:rules` from this repo.
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────
    // Helpers
    // ─────────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    // Admin capability is the 'owner' role in this app's model
    // (UserRole = owner | manager | cashier | accountant; there is no 'admin').
    // 'admin' is accepted too as a defensive fallback for any legacy profile,
    // but 'owner' is the canonical admin-capable role the app checks
    // (auth-context: isAdmin = user.role === 'owner').
    function isActiveAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (userDoc(request.auth.uid).role == 'owner'
            || userDoc(request.auth.uid).role == 'admin')
        && userDoc(request.auth.uid).isActive == true;
    }

    function ownerIsActive(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && userDoc(uid).isActive == true
        && (!('pendingApproval' in userDoc(uid)) || userDoc(uid).pendingApproval == false);
    }

    function subscriptionCanWrite(uid) {
      return !('subscriptionStatus' in userDoc(uid))
        || (
          (userDoc(uid).subscriptionStatus == 'active'
            || userDoc(uid).subscriptionStatus == 'trial')
          && (!('subscriptionEndAtTimestamp' in userDoc(uid))
              || userDoc(uid).subscriptionEndAtTimestamp >= request.time)
        );
    }

    function isActiveOwner(uid) {
      return isOwner(uid) && ownerIsActive(uid) && subscriptionCanWrite(uid);
    }

    function isSelfRegistrationShape(uid) {
      // The self-service trial flow (auth-service.registerUser) creates the
      // auth user via a secondary Firebase app and then writes /users/{uid}
      // BEFORE signing into the main auth — so the create lands as an
      // unauthenticated request from Firestore's perspective. We accept that
      // path only when the shape is exactly an active cashier trial account.
      return request.resource.data.uid == uid
        && request.resource.data.role == 'cashier'
        && request.resource.data.isActive == true
        && request.resource.data.pendingApproval == false
        && request.resource.data.accountType == 'trial'
        && request.resource.data.subscriptionStatus == 'trial'
        && request.resource.data.subscriptionEndAtTimestamp is timestamp
        && request.resource.data.subscriptionEndAtTimestamp >= request.time
        && request.resource.data.subscriptionEndAtTimestamp <= request.time + duration.value(15, 'd');
    }

    // ─────────────────────────────────────────────────────────────────
    // /users/{uid}  — the AppUser profile
    // ─────────────────────────────────────────────────────────────────

    match /users/{uid} {
      // The owner sees their own profile. Active admins can read any profile
      // (used by the admin support pages).
      allow read: if isOwner(uid) || isActiveAdmin();

      // Two creation paths:
      //   - Self-service trial registration: unauthenticated write, but the
      //     shape must match isSelfRegistrationShape (cashier, active trial).
      //   - Admin-created: an active admin creates a profile for another user
      //     (createAppUser uses a secondary auth app, so the setDoc happens
      //     under the admin's session for a different target uid).
      allow create: if isSelfRegistrationShape(uid) || isActiveAdmin();

      // Update rules:
      //   - Active admin can update any field.
      //   - Owner can update their own non-privileged fields (e.g. name,
      //     phone). They must not change role, isActive, pendingApproval,
      //     uid, createdAt, email, or ANY subscription/account field — those
      //     are admin- or system-controlled. Without the subscription block a
      //     trial user could grant themselves a far-future 'active' status and
      //     bypass the entire subscription gate.
      allow update: if isActiveAdmin() || (
        isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny([
                'role', 'isActive', 'pendingApproval', 'uid', 'createdAt', 'email',
                'accountType', 'subscriptionStatus', 'subscriptionStartAt',
                'subscriptionEndAt', 'subscriptionEndAtMs', 'subscriptionEndAtTimestamp',
                'lastRenewedAt', 'renewalCount', 'subscriptionNote', 'contactedAt',
              ])
      );

      // Profile deletion is intentionally not exposed from the client.
      // Admin uses Firebase Auth console to disable accounts.
      allow delete: if false;

      // ───────────────────────────────────────────────────────────────
      // /users/{uid}/{collection}/{docId}  — POS data subcollections
      //   products, bills, billItems, stockMovements, customerPayments,
      //   customers, shifts, settings, meta
      // ───────────────────────────────────────────────────────────────
      match /{collection}/{docId} {
        // Owner reads their own data; admins can read for support.
        allow read: if isOwner(uid) || isActiveAdmin();

        // Only the owner can write, and only while active + approved + subscribed.
        // Inactive / pending / expired / suspended users are blocked at this layer.
        // Admins do not get write permission here — admin support is
        // read-only on POS data (except settings, handled below).
        allow write: if isActiveOwner(uid);
      }



      // ───────────────────────────────────────────────────────────────
      // /users/{uid}/subscriptionRenewals/{docId} — admin audit trail
      // Admins create one row when they renew manually. Users may read their
      // own renewal history, but only admins may append to it.
      // ───────────────────────────────────────────────────────────────
      match /subscriptionRenewals/{docId} {
        allow read: if isOwner(uid) || isActiveAdmin();
        allow create: if isActiveAdmin();
        allow update, delete: if false;
      }

      // ───────────────────────────────────────────────────────────────
      // /users/{uid}/settings/{docId}  — narrow admin write override
      // Admins may update safe operational settings (store name, currency,
      // etc.) from the support dashboard. They cannot write other POS data.
      // ───────────────────────────────────────────────────────────────
      match /settings/{settingsId} {
        allow read: if isOwner(uid) || isActiveAdmin();
        allow write: if isActiveOwner(uid)
          || (isActiveAdmin()
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['storeName', 'cashierName', 'currency', 'allowLossSale', 'lowStockHighlight', 'updatedAt']));
      }
    }
  }
}
